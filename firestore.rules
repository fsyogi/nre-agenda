rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só vale quem está logado com e-mail confirmado
    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() {
      return request.auth.token.email.lower();
    }
    function perfilValido(p) {
      return p in ['admin', 'coordenador', 'consulta'];
    }
    function ehAdmin() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }
    function temAcesso() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function podeEditarAgenda() {
      return temAcesso()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'coordenador'];
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nome', 'perfil', 'criadoEm'])
        && request.resource.data.email == meuEmail()
        && exists(/databases/$(database)/documents/autorizados/$(meuEmail()))
        && request.resource.data.perfil == get(/databases/$(database)/documents/autorizados/$(meuEmail())).data.perfil;
      allow update: if ehAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfil', 'nome'])
        && perfilValido(request.resource.data.perfil);
      allow delete: if ehAdmin() && request.auth.uid != uid;
    }

    match /autorizados/{email} {
      allow get: if logado() && (meuEmail() == email || ehAdmin());
      allow list: if ehAdmin();
      allow create, update: if ehAdmin() && perfilValido(request.resource.data.perfil);
      allow delete: if ehAdmin();
    }

    // Dados do NRE Agenda: todos com acesso leem, admin e coordenador editam
    match /agenda_ag/{id}   { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    match /agenda_canc/{id} { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    match /agenda_obs/{id}  { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    match /agenda_dia/{id}  { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    match /agenda_cfg/{id}  { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    match /agenda_log/{id}  { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
  }
}
