rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só vale quem está logado com e-mail confirmado
    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() {
      return request.auth.token.email.lower();
    }
    function perfilValido(p) {
      return p in ['admin', 'coordenador', 'consulta'];
    }
    function ehAdmin() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }
    function unidadeValida(u) {
      return u in ['', 'NRE/PREV', 'NRE/RH/APOSENTADORIA'];
    }
    function temAcesso() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function podeEditarAgenda() {
      return temAcesso()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'coordenador'];
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nome', 'perfil', 'criadoEm', 'unidade'])
        && unidadeValida(request.resource.data.get('unidade', ''))
        && request.resource.data.email == meuEmail()
        && exists(/databases/$(database)/documents/autorizados/$(meuEmail()))
        && request.resource.data.perfil == get(/databases/$(database)/documents/autorizados/$(meuEmail())).data.perfil;
      allow update: if ehAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfil', 'nome', 'unidade'])
        && perfilValido(request.resource.data.perfil)
        && unidadeValida(request.resource.data.get('unidade', ''));
      allow delete: if ehAdmin() && request.auth.uid != uid;
    }

    match /autorizados/{email} {
      allow get: if logado() && (meuEmail() == email || ehAdmin());
      allow list: if ehAdmin();
      allow create, update: if ehAdmin() && perfilValido(request.resource.data.perfil);
      allow delete: if ehAdmin();
    }

    // Nome de usuário -> e-mail (leitura só por consulta direta; criação só por e-mail liberado)
    match /logins/{usuario} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && usuario.matches('^[a-z0-9._-]{3,30}$')
        && request.resource.data.keys().hasOnly(['email', 'uid', 'unidade'])
        && unidadeValida(request.resource.data.get('unidade', ''))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && exists(/databases/$(database)/documents/autorizados/$(request.auth.token.email.lower()));
      allow delete: if ehAdmin();
    }

    // Dados do NRE Agenda: todos com acesso leem, admin e coordenador editam
    match /agenda_ag/{id}   { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    match /agenda_canc/{id} { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    match /agenda_obs/{id}  { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    match /agenda_cad/{id}  { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    // Atendimento: um registro existente só pode ser regravado por quem tem a mesma marca de criação (tok).
    // Assim, dois usuários que sortearem o mesmo protocolo ao mesmo tempo não se sobrescrevem: o segundo é recusado e o sistema sorteia outro número.
    // Base de consulta (histórico da planilha antiga): leitura para quem tem acesso, só inclusão, nunca altera nem apaga
    match /agenda_hist/{id} {
      allow read: if temAcesso();
      allow create: if podeEditarAgenda() && !exists(/databases/$(database)/documents/agenda_hist/$(id));
      allow update, delete: if false;
    }

    match /agenda_atd/{id}  {
      allow read: if temAcesso();
      allow create: if podeEditarAgenda();
      allow update: if podeEditarAgenda()
        && (!('tok' in resource.data) || request.resource.data.get('tok', '') == resource.data.tok);
      allow delete: if podeEditarAgenda();
    }
    match /agenda_dia/{id}  { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    match /agenda_cfg/{id}  { allow read: if temAcesso(); allow write: if podeEditarAgenda(); }
    // Logs: editores só criam; ninguém altera nem apaga, exceto o administrador
    match /agenda_log/{id}  { allow read: if temAcesso(); allow create: if podeEditarAgenda(); allow update, delete: if ehAdmin(); }
    // Backups automáticos enviados por link (validade 7 dias): só administrador lê;
    // administrador e coordenador criam (o envio pode ser disparado por quem abrir o sistema após o horário);
    // o registro de reserva (b64 vazio) impede envio em duplicidade e pode ser apagado por quem edita
    match /agenda_backup/{id} {
      allow read: if ehAdmin();
      allow create: if podeEditarAgenda()
        && request.resource.data.keys().hasOnly(['b64', 'exp', 'dt', 'us', 'tam'])
        && request.resource.data.exp is number
        && request.resource.data.b64 is string
        && request.resource.data.b64.size() < 950000;
      allow delete: if ehAdmin() || (podeEditarAgenda() && resource.data.b64 == '');
    }
    // Anexos de PDF enviados por link (validade 30 dias): quem tem o endereço (código longo e aleatório) lê só enquanto não vence; ninguém lista; só editores criam e apagam
    match /agenda_anexo/{id} {
      allow get: if resource.data.exp is number && request.time.toMillis() < resource.data.exp;
      allow create: if podeEditarAgenda()
        && request.resource.data.keys().hasOnly(['nome', 'tam', 'tipo', 'b64', 'exp', 'dt', 'us', 'prot', 'st'])
        && request.resource.data.tipo == 'application/pdf'
        && request.resource.data.exp is number
        && ((request.resource.data.b64 is string && request.resource.data.b64.size() < 960000)
            || (request.resource.data.st == true && !('b64' in request.resource.data)));
      // quem abre o documento (tem o código) só pode registrar a abertura: primeira vez, contagem e última vez
      allow update: if resource.data.exp is number && request.time.toMillis() < resource.data.exp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vis', 'nvis', 'visUlt'])
        && request.resource.data.vis is number && request.resource.data.visUlt is number
        && request.resource.data.nvis is number && request.resource.data.nvis >= 1 && request.resource.data.nvis <= 9999;
      allow delete: if podeEditarAgenda();
    }
    // Histórico de conferências do Diário Oficial: leitura por quem tem acesso; editores registram; só o administrador corrige ou apaga
    match /agenda_conf/{id} { allow read: if temAcesso(); allow create: if podeEditarAgenda(); allow update, delete: if ehAdmin(); }
    // Lixeira (30 dias): editores enviam o que excluem; só o administrador lê, restaura e apaga
    match /agenda_lixo/{id} { allow read: if ehAdmin(); allow create: if podeEditarAgenda(); allow update, delete: if ehAdmin(); }
  }
}
