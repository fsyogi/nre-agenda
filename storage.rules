rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function podeEditar() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'coordenador'];
    }
    // PDFs enviados por e-mail: o endereço tem 48 caracteres aleatórios; quem tem o link lê, ninguém lista
    match /anexos/{arq} {
      allow get: if true;
      allow list: if false;
      allow create: if podeEditar()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update: if false;
      allow delete: if podeEditar();
    }
  }
}
